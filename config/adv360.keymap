#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <175>;
        };

        hold_long: hold_long {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_LONG";
            bindings = <&none>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <400>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <200>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1      &kp N2  &kp N3    &kp N4     &kp N5  &to 1                                                          &mo 4                &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp Q       &kp W   &kp E     &kp R      &kp T   &lt 2 LC(R)                                                    &mt RIGHT_ALT LC(Q)  &kp Y   &kp U   &kp I      &kp O     &kp P     &kp BSLH
&kp CAPS   &kp A       &kp S   &kp D     &kp F      &kp G   &mt CAPS LA(G)  &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &mt CAPS LA(Q)       &kp H   &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
&kp LSHFT  &kp Z       &kp X   &kp C     &kp V      &kp B                              &kp HOME      &kp PG_UP                                  &kp N   &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&mo 3      &kp ESCAPE  &to 2   &kp LEFT  &kp RIGHT          &kp BSPC        &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp SPACE                    &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        Neo {
            display-name = "Neo";
            bindings = <
&kp EQUAL  &kp N1    &kp N2     &kp N3    &kp N4     &kp N5  &to 2                                                            &mo 4      &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB    &kp X     &kp V      &kp L     &kp C      &kp W   &kp LEFT_ALT                                                     &kp LALT   &kp K   &kp H   &kp G      &kp F     &kp Q     &kp RIGHT_BRACKET
&kp CAPS   &kp U     &kp I      &kp A     &kp E      &kp O   &kp LCTRL     &kp LCTRL  &kp LALT      &kp LGUI       &kp RCTRL  &kp LCTRL  &kp S   &kp N   &kp R      &kp T     &kp D     &kp Y
&kp LSHFT  &kp LBKT  &kp SLASH  &kp SEMI  &kp P      &kp Z                            &kp CAPS      &kp BACKSLASH                        &kp B   &kp M   &kp COMMA  &kp DOT   &kp J     &kp RSHFT
&mo 3      &kp ESC   &to 2      &kp LEFT  &kp RIGHT          &kp BSPC      &kp DEL    &mo 2         &kp RIGHT_ALT  &kp ENTER  &kp SPACE          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &mo 3
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1     &kp N2    &kp N3     &kp N4     &kp N5      &to 4                                                    &mo 4         &kp N6           &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&kp TAB    &kp PG_UP  &kp BSPC  &kp UP     &kp DEL    &kp PG_DN   &none                                                    &none         &kp EXCLAMATION  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&kp ESC    &kp HOME   &kp LEFT  &kp DOWN   &kp RIGHT  &kp END     &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none         &kp QUESTION     &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&kp LSHFT  &kp ESC    &kp TAB   &kp LG(V)  &kp RET    &kp K_UNDO                       &kp HOME      &kp PG_UP                           &kp COLON        &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&mo 3      &mo 4      &trans    &kp LEFT   &kp RIGHT              &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp NUMBER_0                   &kp UP      &kp DOWN      &kp KP_DOT     &kp LA(SEMI)     &mo 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 2                                      &mo 4   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
