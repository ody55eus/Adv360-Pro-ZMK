/*
 *
 * Neo2 layout for Kinesis Advantage 360 Pro
 *
 * The general idea is to have three layers that can be toggled:
 *
 * – standard Neo2
 * – poor man’s Neo2 ((partial) Neo2 with QWERTZ active on the host system)
 * – poor man’s QWERTZ ((partial) QWERTZ with Neo2 active on the host system)
 *
 * Inspired by:
 * - https://github.com/kaimi/tmk_keyboard/blob/neo2/keyboard/ergodox/keymap_neo.c
 * - https://github.com/urob/zmk-config/blob/main/config/base.keymap
 * - https://github.com/marlonrichert/raise-ergo
 * - https://github.com/kucera-lukas/zmk-config
 */

#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        // Sticky Keys

        skq: sticky_key_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <2000>;
            quick-release;
            ignore-modifiers;
        };

        skh: sticky_key_hold {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&kp>;
            release-after-ms = <2000>;

            /delete-property/ ignore-modifiers;
        };

        //
        // Sticky Layers

        slq: sticky_layer_quick_release {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <2000>;
            quick-release;
            ignore-modifiers;
        };

        slh: sticky_layer_hold {
            compatible = "zmk,behavior-sticky-key";
            #binding-cells = <1>;
            bindings = <&mo>;
            release-after-ms = <2000>;

            /delete-property/ ignore-modifiers;
        };

        /*
         * Hometrigger Mods (hm): hold-preferred
         *
         * Hold (kp <1>)
         * Tap  (kp <2>)
         */

        htm: hometrigger_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMETRIGGER_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
            bindings = <&kp>, <&kp>;
        };

        // Hold (mo <1>)
        // Tap  (kp <2>)
        htl: hometrigger_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMETRIGGER_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <175>;
            flavor = "hold-preferred";
            bindings = <&mo>, <&kp>;
        };


        /*
         * From https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=homerow_mods
         *
         * Homerow Mods (hm): tap-preferred
         *
         * Hold (kp <1>)
         * Tap  (kp <2>)
         */

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /*
         * cross-hand only modifiers, using tap-unless-interrupted and positional hold-tap (hold-trigger-key-positions)
         */
	 
        lh_pht: left_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <200>;   // how long a key must be pressed to trigger the "hold" behavior
            quick-tap-ms = <175>;      // press key again within quick-tap-ms to tap
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;

            // press any key not listed in hold-trigger-key-positions
            // before tapping-term-ms expires, it will produce a tap

            hold-trigger-key-positions = <41 42 43 44 45>;
        };

        rh_pht: right_positional_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <150>;
            quick-tap-ms = <400>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <29 30 31 32 33>;
        };

        /*
         * From https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=autoshift
         *
         * A popular method of implementing Autoshift in ZMK involves a C-preprocessor macro, commonly defined as AS(keycode).
         * This macro applies the LSHIFT modifier to the specified keycode when AS(keycode) is held,
         * and simply performs a keypress, &kp keycode, when the AS(keycode) binding is tapped.
         * This simplifies the use of Autoshift in a keymap, as the complete hold-tap bindings for each desired Autoshift key,
         * as in &as LS(<keycode 1>) <keycode 1> &as LS(<keycode 2>) <keycode 2> ... &as LS(<keycode n>) <keycode n>,
         * can be quite cumbersome to use when applied to a large portion of the keymap.
         *
         * See macro above:
         * #define AS(keycode) &as LS(keycode) keycode     // Autoshift Macro
         *
         * Example:
         * AS(Q) AS(W) AS(E) AS(R) AS(T) AS(Y)
         */

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping_term_ms = <135>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /*
         * From https://zmk.dev/docs/keymaps/behaviors/hold-tap?examples=mo_tog
         *
         * This hold-tap example implements a momentary-layer when the keybind is held and a toggle-layer when it is tapped.
         * Similar to the Autoshift and Sticky Hold use-cases, a MO_TOG(layer)
         * macro is defined such that the &mo and &tog behaviors can target a single layer.
         *
         * Hold
         *   Momentary (mo <1>)
         * Tap
         *   Toggle (tog <2>)
         */

        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };

        /*
         * mo_sl: Momentary Layer or Sticky Layer
         *
         * Hold
         *   Momentary (mo <1>)
         * Tap
         *   Sticky Layer (slq <2>)
         */

        mo_sl: behavior_mo_sl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&slq>;
        };

        kp_skq: behavior_kp_skq {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&skq>;
        };

        // lt_spc: Momentary Layer or Space Sticky Shift Macro
        // Tap: space
        // s-   tap: dot -> space -> sticky shift
        // C-s- tap: excl(!) -> space -> sticky shift
        // Hold: Momentary new layer (mo <1>).

        lt_spc: behavior_lt_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&m_dot_spc>;
        };

        // Tap Dance: tap multiple times for different outcomes
        /*
         * Tap Dance 0 (td0):
         *
         * Tap 1 (kp ESC)
         * Tap 2 (mo 1) (Neo)
         * Tap 3 (mo 5) (QWERTY)
         */

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp ESC>, <&tog 1>, <&tog 5>;

            label = "TapDance-Neo-QWERT";
        };

        // Mod Tap (td_mt):
        //
        // Tap 1: ESC
        // Tap 2: LCTRL
        // Hold: LSHIFT

        td_mt: tap_dance_mod_tap {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&htm LSHIFT ESC>, <&kp LCTRL>;
        };

        // mod-morph (Morphing Keys)
        //
        // From https://zmk.dev/docs/keymaps/behaviors/mod-morph

        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;

            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT)>;
        };

        // From https://github.com/urob/zmk-config/blob/main/config/base.keymap
        // Tap: backspace
        // Lshft + tap: delete
        // Rshft + tap: shift-delete.

        m_bspc: morph_backspace {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp BSPC>, <&kp DEL>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
            keep-mods = <MOD_RSFT>;
        };

        // Tap: comma
        // Shift + tap: semicolon
        // Ctrl + shift + tap: <

        m_inner_comma: morph_inner_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp LESS_THAN>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        m_comma: morph_comma {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&m_inner_comma>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Tap: Space
        // Shift tap: dot              -> space -> sticky shift
        // C-sft-tap: Space

        m_excl_spc: morph_excl_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&macro_spc>, <&kp SPACE>;

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        m_dot_spc: morph_dot_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SPC>, <&m_excl_spc>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        m_emacs12: morph_emacs12 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RC(R)>,    // C-c
	               <&kp RC(U)>;    // C-h

            mods = <(MOD_LCTL|MOD_RCTL)>;
        };

        m_emacs1: morph_emacs1 {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp RC(Q)>,    // C-x
	               <&m_emacs12>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD1";
            #binding-cells = <0>;
            tapping-term-ms = <150>;
            bindings =
                <&m_emacs1>, // Hold:  RGUI   Tap: C-x
                <&htm RCTRL RC(U)>, // Hold: RCTL   Tap: C-h
                <&htm LALT LA(I)>; // Hold:  LALT   Tap: M-g
        };

        td2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD2";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings =
                <&kp LA(H)>, // M-s
                <&kp LA(I)>; // M-g
        };

    	prog_caps: prog_caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <UNDERSCORE MINUS BACKSPACE DELETE>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        /* Keymap 0:
     *
     * Default Layer (Neo2, original QWERTY)
     *
     * This is mostly just the standard Layout with some modifications.
     *
     * ,--------------------------------------------------.           ,--------------------------------------------------.
     * |  Esc   |   1  |   2  |   3  |   4  |   5  |Neo/Md|           | To 4 |   6  |   7  |   8  |   9  |   0  |   -    |
     * |--------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
     * |  Tab   |   X  |   V  |   L  |   C  |   W  | C-c  |           | C-x  |   K  |   H  |   G  |   F  |   Q  |   ß  \ |
     * |--------+------+------+------+------+------|------|           |------|------+------+------+------+------+--------|
     * |  M-w   |   U  |   I  |   A  |   E  |   O  | M-s  |           | M-x  |   S  |   N  |   R  |   T  |   D  |   Y    |
     * |  CAPS  | LGUI | LSHFT| LALT | LCTRL|      |      |           |      |      | RCTRL| RALT | RSHFT| RGUI | CAPS   | <-- Homerow Mods
     * |--------+------+------+------+------+------|------'           `------|------+------+------+------+------+--------|
     * |  LSft  |   Ü  |   Ö  |   Ä  |   P  |   Z  |                         |   B  |   M  |   ,  |   .  |   J  |  RSft  |
     * |--------+------+------+------+------+------'                         `------+------+------+------+------+--------|
     * |  Fn    | ESC  | Kp   | LEFT | RIGHT|                                       |  UP  | DOWN |   [  |   ]  | Fn     |
     * `------------------------------------'                                       `------------------------------------'
     *                                        ,-------------.       ,-------------.
     *                                        | CTRL | ALT  |       | LGUI | CTRL |
     *                                 ,------|------|------|       |------+------+------.
     *                                 |      |      | Mod3 |       | Mod3 |      |      |
     *                                 | SHIFT| SPC  |------|       |------| RET  | SHIFT|
     *                                 |      |      | Mod4 |       | Mod4 |      |      |
     *                                 `--------------------'       `--------------------'
     */

        default_layer {
            display-name = "Base";
            bindings = <
&mo_tog 7 7      &kp N1          &kp N2            &kp N3          &kp N4           &kp N5          &mo_tog 1 1                                                          &mo 4                 &kp N6          &kp N7           &kp N8          &kp N9            &kp N0             &kp MINUS
&kp TAB          &kp Q           &kp W             &kp E           &kp R            &kp T           &mo_sl 12 12                                                         &mo_sl 13 13          &kp Y           &kp U            &kp I           &kp O             &kp P              &kp LBKT
&kp_skq CAPS CAPS  &hm LGUI A    &hm LALT S        &hm LSHFT D     &hm LCTRL F      &hm RALT G      &htm CAPS LC(H)   &kp LCTRL     &kp LALT      &kp LGUI       &kp RCTRL  &htm CAPS LA(Q)    &hm RALT H      &hm RCTRL J      &hm RSHIFT K    &hm RALT L        &hm RGUI SEMI      &hm CAPS SQT
&kp_skq LSHFT LSHFT  &kp Z       &kp X             &kp C           &kp V            &kp B                                           &kp_skq CAPS CAPS  &kp_skq BSLH BSLH                       &kp N           &kp M            &m_comma        &kp DOT           &kp FSLH           &htm RSHFT SPACE
&mo_sl 2 3       &m_dot_spc      &mo_tog 2 2       &mt CAPS LEFT   &mt LGUI RIGHT                   &htm LSHIFT BSPC  &key_repeat   &mo_tog 2 2   &kp RIGHT_ALT  &htm CAPS ENTER  &htm RSHIFT SPACE            &htm CAPS UP     &htm RALT DOWN  &htm CAPS LBKT    &htm RALT RBKT     &mo_sl 12 3
            >;
        };

        /* Keymap 1:
     *
     * Hardware Neo2
     *
     * This is a hardware implementation of Neo2. Allowing to type in Neo2 even if it is not installed.
     *
     * ,--------------------------------------------------.           ,--------------------------------------------------.
     * |  Esc   |   1  |   2  |   3  |   4  |   5  | trans|           | To 4 |   6  |   7  |   8  |   9  |   0  |   -    |
     * |--------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
     * |  Tab   |   X  |   V  |   L  |   C  |   W  | C-c  |           | C-x  |   K  |   H  |   G  |   F  |   Q  |   ß    |
     * |--------+------+------+------+------+------|------|           |------|------+------+------+------+------+--------|
     * | HMod3  |   U  |   I  |   A  |   E  |   O  | M-s  |           | M-x  |   S  |   N  |   R  |   T  |   D  |   Y    |
     * |--------+------+------+------+------+------|------'           `------|------+------+------+------+------+--------|
     * |  LSft  |  Ü [ |  Ö / |  Ä ; |   P  |   Z  |                         |   B  |   M  |   ,  |   .  |   J  |  RSft  |
     * |--------+------+------+------+------+------'                         `------+------+------+------+------+--------|
     * |  Fn    | ESC  | LGUI | LEFT | RIGHT|                                       |  UP  | DOWN |   [  |   ]  | Fn     |
     * `------------------------------------'                                       `------------------------------------'
     *                                        ,-------------.       ,-------------.
     *                                        | trans| trans|       | trans| trans|
     *                                 ,------|------|------|       |------+------+------.
     *                                 |      |      | trans|       | Mod3 |      |      |
     *                                 | trans| trans|------|       |------| trans| trans|
     *                                 |      |      | trans|       | Mod4 |      |      |
     *                                 `--------------------'       `--------------------'
     */

        neo_layer {
            display-name = "Neo";
            bindings = <
&kp EQUAL    &kp N1    &kp N2     &kp N3    &kp N4     &kp N5  &trans                                      &mo 4   &kp N6  &kp N7  &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB      &kp X     &kp V      &kp L     &kp C      &kp W   &mo 2                                       &mo 2   &kp K   &kp H   &kp G      &kp F     &kp Q     &kp BSLH
&mo 6        &kp U     &kp I      &kp A     &kp E      &kp O   &mo 6   &trans  &trans      &trans  &trans  &mo 6   &kp S   &kp N   &kp R      &kp T     &kp D     &kp Y
&kp LSHFT    &kp LBKT  &kp SLASH  &kp SEMI  &kp P      &kp Z                   &mo 6       &mo 6                   &kp B   &kp M   &kp COMMA  &kp DOT   &kp J     &kp RSHFT
&mo_sl 2 3   &kp ESC   &mo_sl 2 2 &kp LEFT  &kp RIGHT          &trans  &trans  &mo 2       &mo 2   &trans  &trans          &kp UP  &kp DOWN   &kp LBKT  &kp RBKT  &trans
            >;
        };

        /* Keymap 2:
     *
     * Keypad (Kp, Mod4)
     *
     * This is a hardware implementation of the Neo2-Mod4 Keypad Layer.
     *
     * ,--------------------------------------------------.           ,--------------------------------------------------.
     * |  Esc   | trans| trans| trans| trans| trans| trans|           | To 4 | M-f  |  NUM |   =  |   /  |   *  |   -    |
     * |--------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
     * |  Tab   | Pg_Up| BKSP |  UP  |  DEL | Pg_Dn| trans|           | trans| C-h  |   7  |   8  |   9  |   -  |   \    |
     * |--------+------+------+------+------+------|------|           |------|------+------+------+------+------+--------|
     * |  Mod3  | HOME | LEFT | DOWN | RIGHT| END  | trans|           | trans| M-s  |   4  |   5  |   6  |   +  |   '    |
     * |--------+------+------+------+------+------|------'           `------|------+------+------+------+------+--------|
     * |  LSft  | ESC  |  TAB | INS  | RET  | UNDO |                         |   :  |   1  |   2  |   3  |  RET |  RSft  |
     * |--------+------+------+------+------+------'                         `------+------+------+------+------+--------|
     * |  MacOST|HMod3 | trans| BriDn| BriUp|                                       | VolUp| VolDn| MUTE | PLAY | Fn     |
     * `------------------------------------'                                       `------------------------------------'
     *                                        ,-------------.       ,-------------.
     *                                        | trans| trans|       | trans| trans|
     *                                 ,------|------|------|       |------+------+------.
     *                                 |      |      | trans|       | trans|      |      |
     *                                 | trans| trans|------|       |------| DEL  |  0   |
     *                                 |      |      | trans|       | trans|      |      |
     *                                 `--------------------'       `--------------------'
     */

        keypad {
            display-name = "Kp";
            bindings = <
&trans       &kp N1     &kp N2    &kp N3        &kp N4        &kp N5      &trans                                       &mo 4         &kp LA(O)  &kp KP_NUM    &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY   &kp MINUS
&kp TAB      &kp PG_UP  &m_bspc   &kp UP        &kp DEL       &kp PG_DN   &trans                                       &trans        &kp LC(U)  &kp KP_N7     &kp KP_N8     &kp KP_N9      &kp KP_MINUS      &kp BSLH
&kp CAPS     &kp HOME   &kp LEFT  &kp DOWN      &kp RIGHT     &kp END     &trans  &trans  &trans      &trans  &trans   &trans        &kp LA(H)  &kp KP_N4     &kp KP_N5     &kp KP_N6      &kp KP_PLUS       &kp SQT
&trans       &kp ESC    &kp TAB   &kp LG(V)     &kp RET       &kp K_UNDO                  &trans      &trans                         &kp COLON  &kp KP_N1     &kp KP_N2     &kp KP_N3      &kp KP_ENTER      &kp RSHFT
&mo_tog 7 5  &mo 6      &trans    &kp C_BRI_DN  &kp C_BRI_UP              &trans  &trans  &trans      &trans  &kp DEL  &kp NUMBER_0             &kp C_VOL_UP  &kp C_VOL_DN  &kp C_MUTE     &kp K_PLAY_PAUSE  &trans
            >;
        };

        /* Keymap 3:
     *
     * Function Keys (Fn)
     *
     * This is the function layer (Fn).
     *
     * ,--------------------------------------------------.           ,--------------------------------------------------.
     * |  F1    | F2   | F3   | F4   | F5   | F6   | QWERT|           | Mo 4 | F7   |  F8  |  F9  | F10  | F11  | F12    |
     * |--------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
     * |  trans | trans| trans| trans| trans| trans| trans|           | trans| trans| trans| trans| trans| trans| trans  |
     * |--------+------+------+------+------+------|------|           |------|------+------+------+------+------+--------|
     * |  trans | trans| trans| trans| trans| trans| trans|           | trans| trans| trans| trans| trans| trans| trans  |
     * |--------+------+------+------+------+------|------'           `------|------+------+------+------+------+--------|
     * |  trans | trans| trans| trans| trans| trans|                         | trans| trans| trans| trans| trans| trans  |
     * |--------+------+------+------+------+------'                         `------+------+------+------+------+--------|
     * |  trans | trans| trans| trans| trans|                                       | trans| trans| trans| trans| trans  |
     * `------------------------------------'                                       `------------------------------------'
     *                                        ,-------------.       ,-------------.
     *                                        | trans| trans|       | trans| trans|
     *                                 ,------|------|------|       |------+------+------.
     *                                 |      |      | trans|       | trans|      |      |
     *                                 | trans| trans|------|       |------| trans| trans|
     *                                 |      |      | trans|       | trans|      |      |
     *                                 `--------------------'       `--------------------'
     */

        fn {
            display-name = "Fn";
            bindings = <
