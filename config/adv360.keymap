        /* Keymap 5:
     *
     * QWERTY Layer (QWERT)
     *
     * This is the poor mans QWERTY. Sometimes you need to enter in qwerty even if neo is active.
     *
     * ,--------------------------------------------------.           ,--------------------------------------------------.
     * |  Esc   |   1  |   2  |   3  |   4  |   5  | To 0 |           | To 4 |   6  |   7  |   8  |   9  |   0  |   -    |
     * |--------+------+------+------+------+-------------|           |------+------+------+------+------+------+--------|
     * |  Tab   |   Q  |   W  |   E  |   R  |   T  | trans|           | trans|   Z  |   U  |   I  |   O  |   P  |  Ü [   |
     * |--------+------+------+------+------+------|------|           |------|------+------+------+------+------+--------|
     * | HMod3  |   A  |   S  |   D  |   F  |   G  | trans|           | trans|   H  |   J  |   K  |   L  |  Ö : |  Ä ;   |
     * |--------+------+------+------+------+------|------'           `------|------+------+------+------+------+--------|
     * |  LSft  |   Y  |   X  |   C  |   V  |   B  |                         |   N  |   M  |   ,  |   .  |   /  |  RSft  |
     * |--------+------+------+------+------+------'                         `------+------+------+------+------+--------|
     * |  Mo 0  | trans| LGUI | LEFT | RIGHT|                                       |  UP  | DOWN |   [  |   ]  | Fn     |
     * `------------------------------------'                                       `------------------------------------'
     *                                        ,-------------.       ,-------------.
     *                                        | LCTL | LALT |       | LGUI | RCTL |
     *                                 ,------|------|------|       |------+------+------.
     *                                 |      |      | CAPS |       | \    |      |      |
     *                                 | BSPC | DEL  |------|       |------| RET  | Space|
     *                                 |      |      |HMod4 |       | RALT |      |      |
     *                                 `--------------------'       `--------------------'
     */

        qwert_layer {
            display-name = "QWERT";
            bindings = <
&kp ESC    &kp N1   &kp N2    &kp N3    &kp N4     &kp N5  &to 0                                                       &mo 4        &kp N6  &kp N7     &kp N8     &kp N9    &kp N0     &kp LBRC
&kp TAB    &kp P    &kp T     &kp F     &kp K      &kp L   &trans                                                      &trans       &kp B   &kp A      &kp S      &kp G     &kp V      &kp Z
&mo 6      &kp D    &kp H     &kp SEMI  &kp O      &kp I   &trans   &kp LCTRL  &kp LALT      &kp LGUI       &kp RCTRL  &trans       &kp U   &kp SLASH  &kp Y      &kp E     &kp X      &kp C
&kp LSHFT  &kp SQT  &kp Q     &kp R     &kp W      &kp N                       &kp CAPS      &kp BACKSLASH                          &kp J   &kp M      &kp COMMA  &kp DOT   &kp MINUS  &kp RSHFT
&mo 0      &trans   &kp LGUI  &kp LEFT  &kp RIGHT          &m_bspc  &kp DEL    &mo 2         &kp RIGHT_ALT  &kp ENTER  &lt_spc 2 0          &kp UP     &kp DOWN   &kp LBKT  &kp RBKT   &mo 0
            >;
        };

